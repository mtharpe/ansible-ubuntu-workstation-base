<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.silent-cycle-current-app"
          path="/org/gnome/shell/extensions/silent-cycle-current-app/">
    <key name="cycle-forward" type="as">
      <default><![CDATA[['<Alt>Above_Tab', '<Super>Above_Tab']]]></default>
      <summary>Cycle to next window of current app</summary>
    </key>
    <key name="cycle-backward" type="as">
      <default><![CDATA[['<Shift><Alt>Above_Tab', '<Shift><Super>Above_Tab']]]></default>
      <summary>Cycle to previous window of current app</summary>
    </key>
  </schema>
</schemalist>
